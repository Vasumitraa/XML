<!ELEMENT annuaire (personnes)>
<!ELEMENT personnes (personne+)>
<!ELEMENT personne (nom, prenom+, genre, adresse, telephones+, emails+)>
<!ATTLIST personne id CDATA #REQUIRED>
<!ELEMENT nom (#PCDATA)>
<!ELEMENT prenom (#PCDATA)>
<!ELEMENT genre (#PCDATA)>
<!ELEMENT adresse (pays, ville, rue, numero)>
<!ELEMENT pays (#PCDATA)>
<!ELEMENT ville (#PCDATA)>
<!ELEMENT rue (#PCDATA)>
<!ELEMENT numero (#PCDATA)>
<!ELEMENT telephones (telephone)>
<!ELEMENT telephone (#PCDATA)>
<!ATTLIST telephone type CDATA #IMPLIED>
<!ELEMENT emails (email)>
<!ATTLIST email type CDATA #IMPLIED>
