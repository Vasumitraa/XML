<!ELEMENT livres (livre+)>

<!ELEMENT livre (titre, auteur, genre, date)>
<!ATTLIST livre id CDATA #REQUIRED>
<!ELEMENT titre (#PCDATA)>
<!ELEMENT auteur (prenom, nom, prenom, nom)>
<!ELEMENT prenom (#PCDATA)>
<!ELEMENT nom (#PCDATA)>
<!ELEMENT genre (#PCDATA)>
<!ELEMENT date (#PCDATA)>
<!ATTLIST date format (DD-MM-YYYY) #REQUIRED>